    function saveStudyProgress() {
      const stateObj = {
        activeTab: currentActiveTab,
        selectedUnits: Array.from(selectedUnits),
        onlyMistakes: onlyMistakesFilter,
        speechRate,
        autoAudio,
        quizAutoNext,
        quizDirection,
        quizIndex,
        quizScore,
        quizPoolIds: quizPool.map(i => i.id),
        fcIndex,
        dictIndex
      };
