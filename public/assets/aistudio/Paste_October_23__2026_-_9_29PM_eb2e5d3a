      const clean = text.split("/")[0].replace(/\([^)]*\)/g, "").trim();
      if ("speechSynthesis" in window) {
        window.speechSynthesis.cancel();
        const u = new SpeechSynthesisUtterance(clean);
        u.lang = "en-US";
        u.rate = speechRate;
        window.speechSynthesis.speak(u);
      }
    }

