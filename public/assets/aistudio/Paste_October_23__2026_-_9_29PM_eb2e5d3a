      document.getElementById("btnDashQuickFlashcard").onclick = () => switchActiveTab("flashcard");
      document.getElementById("btnResetProgress").onclick = () => {
        if(confirm("Bạn muốn xóa toàn bộ lịch sử ôn tập (SRS & Lỗi sai) của chuyên ngành này để học lại từ đầu?")) {
            vocabList.forEach(v => { v.srsLevel = 0; v.mistakeCount = 0; });
            saveDatabase(); syncAllViews(); showToast("Đã làm mới tiến độ học tập!");
        }
      };

      // Quiz
      document.getElementById("quizDirectionSelect").onchange = e => { quizDirection = e.target.value; saveStudyProgress(); resetQuizPool(); };
      document.getElementById("btnShuffleQuiz").onclick = () => { resetQuizPool(); showToast("Đã đảo câu hỏi!"); };
      document.getElementById("chkQuizAutoNext").onchange = e => { quizAutoNext = e.target.checked; saveStudyProgress(); };
      document.getElementById("btnNextQuizQuestion").onclick = () => { quizIndex++; saveStudyProgress(); loadQuizQuestion(); };
      document.getElementById("btnSpeakQuizPrompt").onclick = () => {
        if (!currentQuizItem) return;
        if (!currentQuizAnswered && currentQuizModeType !== "en-vi") { showToast("Chọn đáp án trước khi nghe!", "info"); return; }
        speakText(currentQuizItem.word);
      };
      document.getElementById("btnSpeakExample").onclick = () => { if (currentQuizItem) speakText(currentQuizItem.example); };
      document.getElementById("btnShowQuizHint").onclick = () => {
        if (!currentQuizItem) return;
        const hintEl = document.getElementById("quizHintBox");
        hintEl.textContent = `💡 Ngữ cảnh: "${maskWordInSentence(currentQuizItem.example, currentQuizItem.word)}" (${currentQuizItem.exampleVi})`;
        hintEl.classList.remove("hidden");
      };
      document.getElementById("btnAskAiQuiz").onclick = async () => {
        if(currentQuizItem) {
          document.getElementById("aiHubModal").classList.remove("hidden");
          document.getElementById("aiResponseBox").textContent = `⏳ Đang phân tích "${currentQuizItem.word}"...`;
          document.getElementById("aiResponseBox").textContent = await queryThreeTierAi(`Phân tích thuật ngữ "${currentQuizItem.word}".`);
        }
      };

      // Flashcard
      document.getElementById("fcCardInner").onclick = function () { triggerHaptic("light"); this.classList.toggle("rotate-y-180"); };
      document.getElementById("btnFcSpeakFront").onclick = e => { e.stopPropagation(); if (fcPool[fcIndex]) speakText(fcPool[fcIndex].word); };
      document.getElementById("btnFcAiExplain").onclick = async e => {
        e.stopPropagation();
        if (fcPool[fcIndex]) {
          document.getElementById("aiHubModal").classList.remove("hidden");
          document.getElementById("aiResponseBox").textContent = `⏳ Đang phân tích "${fcPool[fcIndex].word}"...`;
          document.getElementById("aiResponseBox").textContent = await queryThreeTierAi(`Phân tích thuật ngữ "${fcPool[fcIndex].word}".`);
        }
      };
      document.getElementById("btnFcShuffle").onclick = () => {
        fcPool.sort(() => Math.random() - 0.5); fcIndex = 0; renderFlashcard(true); showToast("Đã trộn thẻ!");
      };
      document.getElementById("btnFcPrev").onclick = () => { fcIndex--; saveStudyProgress(); renderFlashcard(); };
      document.getElementById("btnFcNext").onclick = () => { fcIndex++; saveStudyProgress(); renderFlashcard(); };
      
      const bindSrs = (id, lvl) => {
        document.getElementById(id).onclick = () => {
          const item = fcPool[fcIndex];
          if (!item) return;
          item.srsLevel = lvl;
          if (lvl === 3) item.mistakeCount = 0; else if (lvl === 1) item.mistakeCount = Math.max(1, item.mistakeCount || 0);
          saveDatabase(); triggerHaptic("success"); fcIndex++; saveStudyProgress(); renderFlashcard();
          if (autoAudio && fcPool[fcIndex]) speakText(fcPool[fcIndex].word);
        };
      };
      bindSrs("btnSrsHard", 1); bindSrs("btnSrsGood", 2); bindSrs("btnSrsEasy", 3);

      // Dictation
      document.getElementById("btnDictSpeak").onclick = () => { if (getFilteredVocab()[dictIndex]) speakText(getFilteredVocab()[dictIndex].word); };
      document.getElementById("btnDictShowAnswer").onclick = () => {
        const item = getFilteredVocab()[dictIndex];
        if (!item) return;
        const fb = document.getElementById("dictFeedback");
        fb.className = "text-xs font-extrabold text-amber-600 dark:text-amber-400"; fb.textContent = `💡 Đáp án: ${item.word} (${item.ipa})`;
        speakText(item.word);
      };
      document.getElementById("btnDictSkip").onclick = () => { dictIndex++; saveStudyProgress(); renderDictation(); };
      document.getElementById("dictForm").onsubmit = e => {
        e.preventDefault();
        if (isDictTransitioning) return;
        const item = getFilteredVocab()[dictIndex];
        if (!item) return;
        const val = document.getElementById("dictInput").value.trim().toLowerCase();
        const fb = document.getElementById("dictFeedback");

        if (getAcceptedDictationTargets(item.word).includes(val)) {
          isDictTransitioning = true; playTone(780, "sine"); triggerHaptic("success"); recordStudyOutcome(item, true);
          fb.className = "text-xs font-extrabold text-emerald-600 dark:text-emerald-400"; fb.textContent = `✅ Chính xác! ${item.word} (${item.ipa})`;
          setTimeout(() => { dictIndex++; saveStudyProgress(); renderDictation(); }, 1000);
        } else {
          playTone(240, "sawtooth"); triggerHaptic("error"); recordStudyOutcome(item, false);
          fb.className = "text-xs font-extrabold text-rose-600 dark:text-rose-400"; fb.textContent = `❌ Chưa khớp! Hãy nghe lại hoặc "Xem đáp án"`;
        }
      };

      // Sprint
      document.getElementById("btnStartSprintGame").onclick = () => {
        sprintSeconds = 60; sprintScore = 0; sprintCombo = 1;
        document.getElementById("sprintTimeText").textContent = "60s"; document.getElementById("sprintScoreText").textContent = "0 điểm";
        document.getElementById("sprintComboBadge").textContent = "Combo x1";
        document.getElementById("sprintIntroView").classList.add("hidden"); document.getElementById("sprintPlayView").classList.remove("hidden");
        document.getElementById("btnStopSprintGame").classList.remove("hidden");
        nextSprintQuestion();
        clearInterval(sprintTimer);
        sprintTimer = setInterval(() => {
          sprintSeconds--; document.getElementById("sprintTimeText").textContent = `${sprintSeconds}s`;
          if (sprintSeconds <= 0) finishSprintGame();
        }, 1000);
      };
      document.getElementById("btnStopSprintGame").onclick = finishSprintGame;

      // Tab 5: Manage & AI
      document.getElementById("btnToggleSingleAdd").onclick = () => {
        document.getElementById("addWordForm").classList.remove("hidden"); document.getElementById("batchAddContainer").classList.add("hidden");
        document.getElementById("btnToggleSingleAdd").className = "px-3 py-1.5 rounded-xl bg-teal-600 text-white text-xs font-bold transition";
        document.getElementById("btnToggleBatchAdd").className = "px-3 py-1.5 rounded-xl bg-slate-100 dark:bg-slate-700 text-slate-700 dark:text-slate-200 text-xs font-bold transition";
      };
      document.getElementById("btnToggleBatchAdd").onclick = () => {
        document.getElementById("addWordForm").classList.add("hidden"); document.getElementById("batchAddContainer").classList.remove("hidden");
        document.getElementById("btnToggleBatchAdd").className = "px-3 py-1.5 rounded-xl bg-teal-600 text-white text-xs font-bold transition";
        document.getElementById("btnToggleSingleAdd").className = "px-3 py-1.5 rounded-xl bg-slate-100 dark:bg-slate-700 text-slate-700 dark:text-slate-200 text-xs font-bold transition";
      };

      document.getElementById("addWordForm").onsubmit = async e => {
        e.preventDefault();
        const btn = document.getElementById("btnSubmitSingleWord");
        btn.disabled = true; btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Đang xử lý...';
        
        const u = document.getElementById("newUnitInput").value.trim() || "Unit 5";
        const w = document.getElementById("newWordInput").value.trim();
        const m = document.getElementById("newMeaningInput").value.trim();
        
        if (w) {
            const enriched = await enrichWordWithAiFallback(w, m, u);
            vocabList.push(enriched);
            selectedUnits.add(u);
            saveDatabase(); syncAllViews(); e.target.reset();
            showToast(`Đã làm giàu & lưu "${enriched.word}" vào ${u}!`);
        }
        btn.disabled = false; btn.innerHTML = '<i class="fa-solid fa-wand-magic-sparkles"></i> Lưu & Làm Giàu';
      };

      document.getElementById("btnRunBatchEnrich").onclick = async () => {
        const rawText = document.getElementById("batchRawInput").value;
        const unit = document.getElementById("batchUnitInput").value.trim() || "Unit 5";
        if (!rawText.trim()) return showToast("Vui lòng dán danh sách từ vựng!", "error");
        
        const btn = document.getElementById("btnRunBatchEnrich");
        btn.disabled = true; btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin mr-1"></i> Đang xử lý...';
        
        const lines = rawText.split("\n").map(l => l.trim()).filter(Boolean);
        let added = 0;
        for (const line of lines) {
          const parts = line.split(/[:\-\t]/);
          const word = parts[0].trim();
          const meaning = parts.length > 1 ? parts.slice(1).join(" ").trim() : "";
          if (word) {
            const enriched = await enrichWordWithAiFallback(word, meaning, unit);
            vocabList.push(enriched); added++;
          }
        }
        selectedUnits.add(unit); saveDatabase(); syncAllViews();
        document.getElementById("batchProgressStatus").textContent = `✅ Đã thêm ${added} từ vào ${unit}!`;
        document.getElementById("batchRawInput").value = "";
        showToast(`Đã làm giàu và lưu ${added} từ vào ${unit}!`);
        btn.disabled = false; btn.innerHTML = '<i class="fa-solid fa-wand-magic-sparkles mr-1"></i> Tự Làm Giàu & Lưu Hàng Loạt';
      };
      document.getElementById("searchVocabInput").oninput = e => renderVocabTree(e.target.value);

      // Tab 6: CBT
      document.getElementById("btnGenerateCBT").onclick = () => {
        const requestedCount = parseInt(document.getElementById("cbtQuestionCount").value, 10) || 40;
        const examDir = document.getElementById("cbtExamDirection").value;
        const isStrict = document.getElementById("chkStrictSyllabusMode")?.checked;
        
        let candidatePool = [];
        if (parsedSyllabusWords.length > 0 && isStrict) {
            candidatePool = [...parsedSyllabusWords];
        } else {
            const syllabusInput = document.getElementById("cbtSyllabusInput").value.toLowerCase().trim();
            if (syllabusInput) {
                candidatePool = vocabList.filter(v => syllabusInput.includes(v.word.toLowerCase().split("/")[0].trim()) || syllabusInput.includes(v.meaning.toLowerCase()) || syllabusInput.includes(v.unit.toLowerCase()));
            }
        }
        
        if (candidatePool.length < Math.min(5, requestedCount)) {
            candidatePool = [...getFilteredVocab()];
            showToast("Số lượng từ vựng trong đề cương quá ít, hệ thống đã bù thêm từ ngẫu nhiên!", "info");
        }

        const shuffled = [...candidatePool].sort(() => Math.random() - 0.5).slice(0, requestedCount);
        cbtTotalQuestions = shuffled.length; cbtTimeLeft = cbtTotalQuestions * 45;

        cbtPool = shuffled.map(q => {
          const dist = getDistinctDistractors(q, 3);
          const lockedOptions = [q, ...dist].sort(() => Math.random() - 0.5);
          let qType = examDir;
          if (examDir === "mix") qType = ["en-vi", "vi-en", "context"][Math.floor(Math.random() * 3)];
          return { ...q, qType, lockedOptions };
        });

        cbtAnswers = {}; cbtFlags = {}; cbtCurrentIndex = 0;
        document.getElementById("cbtSetupView").classList.add("hidden"); document.getElementById("cbtResultView").classList.add("hidden");
        document.getElementById("cbtExamView").classList.remove("hidden");

        updateCBTTimerDisplay(); clearInterval(cbtTimerInterval);
        cbtTimerInterval = setInterval(() => {
          cbtTimeLeft--; updateCBTTimerDisplay(); saveCBTState();
          if (cbtTimeLeft <= 0) { clearInterval(cbtTimerInterval); showToast("Hết giờ! Tự động thu bài.", "error"); submitCBTExam(); }
        }, 1000);
        renderCBTQuestion(); saveCBTState();
      };

      document.getElementById("btnCBTPrev").onclick = () => { if (cbtCurrentIndex > 0) { cbtCurrentIndex--; saveCBTState(); renderCBTQuestion(); }};
      document.getElementById("btnCBTNext").onclick = () => { if (cbtCurrentIndex < cbtTotalQuestions - 1) { cbtCurrentIndex++; saveCBTState(); renderCBTQuestion(); }};
      document.getElementById("btnFlagCBT").onclick = () => { cbtFlags[cbtCurrentIndex] = !cbtFlags[cbtCurrentIndex]; saveCBTState(); renderCBTQuestion(); };
      document.getElementById("btnSubmitCBT").onclick = () => {
          const answered = Object.keys(cbtAnswers).length;
          if (answered < cbtTotalQuestions && cbtTimeLeft > 0) {
              if (!confirm(`Bạn mới làm ${answered}/${cbtTotalQuestions} câu. Bạn có chắc chắn muốn nộp bài sớm?`)) return;
          }
          submitCBTExam();
      };
      document.getElementById("btnCBTRetry").onclick = () => {
        localStorage.removeItem(STORAGE_KEY_CBT_STATE);
        document.getElementById("cbtResultView").classList.add("hidden"); document.getElementById("cbtSetupView").classList.remove("hidden");
      };
      document.getElementById("btnCBTReviewMistakes").onclick = () => {
        onlyMistakesFilter = true; document.getElementById("chkOnlyMistakes").checked = true;
        saveStudyProgress(); syncAllViews(); switchActiveTab("quiz"); showToast("Bật Ôn tập câu sai!", "info");
      };

      // AI & Specialty Modals
      document.getElementById("createSpecialtyForm").onsubmit = e => {
        e.preventDefault();
        const name = document.getElementById("newSpecName").value.trim(), icon = document.getElementById("newSpecIcon").value;
        if (!name) return;
        const newId = "spec_" + Date.now();
        specialtiesMap[newId] = { id: newId, name, icon, vocab: [] };
        saveDatabase(); loadSpecialtyState(newId, true); e.target.reset();
        document.getElementById("specialtyModal").classList.add("hidden"); showToast(`Đã tạo chuyên ngành "${name}"!`);
      };

      document.querySelectorAll("[data-quick-ai]").forEach(btn => {
        btn.onclick = async () => {
          const q = btn.getAttribute("data-quick-ai");
          document.getElementById("aiCustomPromptInput").value = q;
          document.getElementById("aiResponseBox").textContent = "⏳ Đang phân tích dữ liệu lâm sàng...";
          document.getElementById("aiResponseBox").textContent = await queryThreeTierAi(q);
        };
      });

      document.getElementById("aiCustomPromptForm").onsubmit = async e => {
        e.preventDefault();
        const q = document.getElementById("aiCustomPromptInput").value.trim();
        if (!q) return;
        document.getElementById("aiResponseBox").textContent = "⏳ Đang phân tích dữ liệu lâm sàng...";
        document.getElementById("aiResponseBox").textContent = await queryThreeTierAi(q);
      };

      document.getElementById("btnSaveAiKey").onclick = () => {
        const k = document.getElementById("userGeminiKeyInput").value.trim();
        if (!k) return showToast("Vui lòng dán API Key!", "error");
        localStorage.setItem(STORAGE_KEY_AI_KEY, k); showToast("Đã lưu Gemini API Key!");
      };
      document.getElementById("btnClearAiKey").onclick = () => {
        localStorage.removeItem(STORAGE_KEY_AI_KEY); document.getElementById("userGeminiKeyInput").value = ""; showToast("Đã xóa API Key.", "info");
      };

      // JSON Export/Import
      document.getElementById("btnExportJsonText").onclick = () => { document.getElementById("jsonTextBox").value = JSON.stringify(vocabList, null, 2); showToast("Đã xuất JSON!"); };
      document.getElementById("btnResetDefaultData").onclick = () => {
        vocabList = SEED_DATA_191.map(i => ({ ...i })); selectedUnits = new Set(getAllUnits());
        saveDatabase(); syncAllViews(); document.getElementById("jsonModal").classList.add("hidden"); showToast("Đã khôi phục dữ liệu gốc!");
      };
      document.getElementById("btnImportJsonReplace").onclick = () => {
        try {
          const parsed = JSON.parse(document.getElementById("jsonTextBox").value);
          const arr = Array.isArray(parsed) ? parsed : (parsed.vocab || []);
          if (arr.length > 0) {
            vocabList = arr; selectedUnits = new Set(getAllUnits());
            saveDatabase(); syncAllViews(); document.getElementById("jsonModal").classList.add("hidden"); showToast(`Đã ghi đè ${arr.length} từ vựng!`);
          }
        } catch (e) { showToast("Lỗi định dạng JSON!", "error"); }
      };
      document.getElementById("btnImportJsonMerge").onclick = () => {
        try {
          const parsed = JSON.parse(document.getElementById("jsonTextBox").value);
          const arr = Array.isArray(parsed) ? parsed : (parsed.vocab || []);
          const existingIds = new Set(vocabList.map(v => v.id)); let added = 0;
          arr.forEach(item => {
            if (item && item.word && !existingIds.has(item.id)) { vocabList.push(item); if (item.unit) selectedUnits.add(item.unit); added++; }
          });
          saveDatabase(); syncAllViews(); document.getElementById("jsonModal").classList.add("hidden"); showToast(`Đã hợp nhất thêm ${added} từ mới!`);
        } catch (e) { showToast("Lỗi định dạng JSON!", "error"); }
      };

      // Keyboard Shortcuts
      window.addEventListener("keydown", e => {
        if (["INPUT", "TEXTAREA", "SELECT"].includes(document.activeElement?.tagName)) return;
        if (currentActiveTab === "quiz") {
          if (["1", "2", "3", "4"].includes(e.key) && !currentQuizAnswered) {
            const btns = document.querySelectorAll(".quiz-opt-btn");
            if (btns[parseInt(e.key, 10) - 1]) btns[parseInt(e.key, 10) - 1].click();
          } else if ((e.key === "Enter" || e.key === "ArrowRight") && currentQuizAnswered) {
            document.getElementById("btnNextQuizQuestion").click();
          } else if (e.code === "Space") {
            e.preventDefault(); document.getElementById("btnSpeakQuizPrompt").click();
          }
        } else if (currentActiveTab === "flashcard") {
          if (e.code === "Space") {
            e.preventDefault(); document.getElementById("btnFcSpeakFront").click();
          } else if (e.key === "ArrowRight") { document.getElementById("btnFcNext").click();
          } else if (e.key === "ArrowLeft") { document.getElementById("btnFcPrev").click();
          } else if (["ArrowUp", "ArrowDown", "Enter"].includes(e.key)) { e.preventDefault(); document.getElementById("fcCardInner").click(); }
        }
      });
    });
  </script>
</body>
</html>