    function getAcceptedDictationTargets(rawWord) {
      const targets = new Set();
      if (!rawWord) return [""];
      rawWord.split("/").forEach(part => {
        const clean = part.replace(/\([^)]*\)/g, "").trim().toLowerCase();
        if (clean) targets.add(clean);
        const match = part.match(/\(([^)]+)\)/);
        if (match && match[1]) targets.add(match[1].trim().toLowerCase());
      });
      targets.add(rawWord.replace(/\([^)]*\)/g, "").trim().toLowerCase());
      return Array.from(targets);
    }

