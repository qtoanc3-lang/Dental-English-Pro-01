    function loadQuizQuestion() {
      if (!quizPool.length) quizPool = [...getFilteredVocab()];
      if (!quizPool.length) return;
      if (quizIndex >= quizPool.length) quizIndex = 0;

      currentQuizItem = quizPool[quizIndex];
