    async function queryThreeTierAi(promptText) {
      const sysPrompt = "Bạn là Trợ lý Nha khoa & Y khoa. Hãy giải thích ngắn gọn, chuẩn xác thuật ngữ lâm sàng, dễ nhớ cho sinh viên.";
      if (window.ai && window.ai.languageModel) {
        try {
          const cap = await window.ai.languageModel.capabilities();
          if (cap.available === "readily") {
            const session = await window.ai.languageModel.create({ systemPrompt: sysPrompt });
            return await session.prompt(promptText);
          }
        } catch (e) {}
      }
      const apiKey = localStorage.getItem(STORAGE_KEY_AI_KEY);
      if (apiKey) {
        const models = ["gemini-2.5-flash", "gemini-2.0-flash", "gemini-1.5-flash-latest"];
        for (const m of models) {
          try {
            const res = await fetch(`https://generativelanguage.googleapis.com/v1beta/models/${m}:generateContent?key=${apiKey}`, {
              method: "POST", headers: { "Content-Type": "application/json" },
              body: JSON.stringify({ contents: [{ parts: [{ text: `${sysPrompt}\n\n${promptText}` }] }] })
            });
            const data = await res.json();
            const reply = data?.candidates?.[0]?.content?.parts?.[0]?.text;
            if (reply) return reply;
          } catch (e) {}
        }
      }
      return buildOfflineMedicalAnalysis(promptText);
    }

    function buildOfflineMedicalAnalysis(q) {
      const lower = q.toLowerCase();
      const matchedWords = vocabList.filter(v => lower.includes(v.word.toLowerCase().split("/")[0].trim()) || v.meaning.toLowerCase().includes(lower));
      if (matchedWords.length >= 2) {
        const w1 = matchedWords[0], w2 = matchedWords[1];
        return `🩺 PHÂN TÍCH SO SÁNH LÂM SÀNG:\n\n1️⃣ ${w1.word} (${w1.ipa}): ${w1.meaning}\n   • Lâm sàng: ${w1.clinicalNote}\n\n2️⃣ ${w2.word} (${w2.ipa}): ${w2.meaning}\n   • Lâm sàng: ${w2.clinicalNote}`;
      }
      if (matchedWords.length === 1) {
        const w = matchedWords[0];
        return `🦷 HỒ SƠ THUẬT NGỮ LÂM SÀNG:\n\n• ${w.word} (${w.ipa}) — ${w.pos}\n• Nghĩa: ${w.meaning}\n• Ghi chú: ${w.clinicalNote}\n• Ví dụ: "${w.example}" (${w.exampleVi})`;
      }
      const matchedRoots = MEDICAL_ROOT_LEXICON.filter(r => lower.includes(r.aff));
      if (matchedRoots.length > 0) {
        return `🧬 GIẢI MÃ GỐC TỪ & HẬU TỐ:\n\n` + matchedRoots.map(r => `• ${r.type}: ${r.mean}\n  ➔ Ứng dụng: ${r.note}`).join("\n\n");
      }
      if (lower.includes("hội thoại") || lower.includes("khám")) {
        return `💬 MẪU HỘI THOẠI LÂM SÀNG:\n\n👨‍⚕️ Dentist: "What brings you to the clinic?" (Hôm nay bạn đến phòng khám vì vấn đề gì?)\n🧑 Patient: "I have severe throbbing pain." (Tôi bị đau nhức dữ dội.)`;
      }
      return `📚 TRỢ LÝ Y KHOA NỘI TUYẾN:\nChưa tìm thấy dữ liệu sâu cho: "${q}". Hãy dán Gemini API Key ở mục Cài đặt để mở rộng trí tuệ nhân tạo.`;
    }

    async function enrichWordWithAiFallback(word, meaning, unit) {
        const cleanW = word.trim();
        const lowerW = cleanW.toLowerCase();
        let detectedMeaning = meaning ? meaning.trim() : "";
        let detectedPos = "n.";
        let detectedNote = "Thuật ngữ chuyên ngành Y - Nha khoa.";
        const related = ["Clinical practice"];

        for (const entry of MEDICAL_ROOT_LEXICON) {
            if (lowerW.includes(entry.aff)) {
            if (!detectedMeaning) detectedMeaning = `${entry.mean} (${cleanW})`;
            detectedPos = entry.pos;
            detectedNote = `${entry.type}: ${entry.mean}. ${entry.note}`;
            related.push(entry.type);
            break;
            }
        }
        if (!detectedMeaning) detectedMeaning = `Thuật ngữ: ${cleanW}`;

        return {
            id: "custom_" + Date.now() + "_" + Math.random().toString(36).slice(2, 6),
            unit: unit || "Unit 5",
            word: cleanW,
            ipa: `/${lowerW}/`,
            pos: detectedPos,
            meaning: detectedMeaning,
            relatedTerms: related,
            example: `Clinical evaluation of ${lowerW} is essential for accurate dental diagnosis.`,
            exampleVi: `Đánh giá lâm sàng về ${detectedMeaning.toLowerCase()} rất cần thiết để chẩn đoán chính xác.`,
            clinicalNote: detectedNote,
            srsLevel: 0,
            mistakeCount: 0
        };
    }

