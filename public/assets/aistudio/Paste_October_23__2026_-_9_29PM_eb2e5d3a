      document.getElementById("quizCounterText").textContent = `Câu ${quizIndex + 1} / ${quizPool.length}`;
      document.getElementById("quizUnitBadge").textContent = currentQuizItem.unit;
      document.getElementById("quizExplanationBox").classList.add("hidden");
      document.getElementById("quizHintBox").classList.add("hidden");

      if (quizDirection === "mix") {
        const modes = ["en-vi", "vi-en", "context"];
        currentQuizModeType = modes[Math.floor(Math.random() * modes.length)];
      } else {
        currentQuizModeType = quizDirection;
      }

