      if (rawSpecs) {
        try { specialtiesMap = JSON.parse(rawSpecs); } catch (e) { specialtiesMap = {}; }
      }

      if (!specialtiesMap["dental"] || !Array.isArray(specialtiesMap["dental"].vocab)) {
        specialtiesMap["dental"] = {
          id: "dental", name: "Răng Hàm Mặt", icon: "fa-tooth",
          vocab: SEED_DATA_191.map(i => ({ ...i }))
        };
        localStorage.setItem(STORAGE_KEY_SPECIALTIES, JSON.stringify(specialtiesMap));
      } else {
        const savedVocab = specialtiesMap["dental"].vocab;
        const savedMap = new Map(savedVocab.map(v => [v.id, v]));
        const merged = SEED_DATA_191.map(seed => {
          if (savedMap.has(seed.id)) {
            const cur = savedMap.get(seed.id);
            return {
              ...seed,
              srsLevel: cur.srsLevel !== undefined ? cur.srsLevel : seed.srsLevel,
              mistakeCount: cur.mistakeCount !== undefined ? cur.mistakeCount : seed.mistakeCount
            };
          }
          return { ...seed };
        });
        savedVocab.forEach(custom => {
          if (!merged.some(m => m.id === custom.id)) merged.push(custom);
        });
        specialtiesMap["dental"].vocab = merged;
        localStorage.setItem(STORAGE_KEY_SPECIALTIES, JSON.stringify(specialtiesMap));
      }

      currentSpecialtyId = localStorage.getItem(STORAGE_KEY_CURRENT_SPEC) || "dental";
