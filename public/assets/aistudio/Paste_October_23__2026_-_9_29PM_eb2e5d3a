    cbtFileInput.addEventListener('change', async (e) => {
        const file = e.target.files[0];
        if(!file) return;

        btnSelectSyllabusFile.classList.add("hidden");
        btnClearSyllabusFile.classList.remove("hidden");
        cbtFileStatusBox.classList.remove("hidden");
        cbtUploadedFileName.textContent = file.name;
        cbtFileLoadingOverlay.classList.remove("hidden");
        cbtFileLoadingOverlay.style.display = "flex";
        cbtMatchedCountBadge.textContent = "Đang quét...";
        cbtMatchedWordsPreview.textContent = "Hệ thống đang trích xuất văn bản từ tệp tin của bạn...";

        try {
            let extractedText = "";
            const ext = file.name.split('.').pop().toLowerCase();
            
            if(['txt', 'csv', 'json', 'md'].includes(ext)) {
                extractedText = await file.text();
            } else if(ext === 'docx') {
                const ab = await file.arrayBuffer();
                const res = await mammoth.extractRawText({arrayBuffer: ab});
                extractedText = res.value;
            } else if(ext === 'pdf') {
                const ab = await file.arrayBuffer();
                const pdf = await pdfjsLib.getDocument({data: ab}).promise;
                for(let i=1; i<=pdf.numPages; i++){
                    const page = await pdf.getPage(i);
                    const content = await page.getTextContent();
                    extractedText += content.items.map(it => it.str).join(" ") + " ";
                }
            } else {
                throw new Error("Định dạng file không được hỗ trợ.");
            }
            
            document.getElementById("cbtSyllabusInput").value = extractedText.trim();
            analyzeSyllabus(extractedText);
            
        } catch(err) {
            showToast("Lỗi đọc file: " + err.message, "error");
            btnClearSyllabusFile.click();
        } finally {
            cbtFileLoadingOverlay.classList.add("hidden");
            cbtFileLoadingOverlay.style.display = "none";
        }
    });

