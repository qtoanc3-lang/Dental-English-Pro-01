    function restoreStudyProgress() {
      const saved = localStorage.getItem(STORAGE_KEY_APP_SETTINGS);
      if (!saved) return false;
      try {
        const s = JSON.parse(saved);
        if (s.speechRate) speechRate = s.speechRate;
        if (s.autoAudio !== undefined) autoAudio = s.autoAudio;
        if (s.quizAutoNext !== undefined) quizAutoNext = s.quizAutoNext;
        if (s.quizDirection) quizDirection = s.quizDirection;
        if (s.quizIndex !== undefined) quizIndex = s.quizIndex;
        if (s.quizScore !== undefined) quizScore = s.quizScore;
        if (s.fcIndex !== undefined) fcIndex = s.fcIndex;
        if (s.dictIndex !== undefined) dictIndex = s.dictIndex;
        if (s.onlyMistakes !== undefined) onlyMistakesFilter = s.onlyMistakes;
        if (Array.isArray(s.selectedUnits) && s.selectedUnits.length > 0) {
          selectedUnits = new Set(s.selectedUnits);
        }
        if (s.quizPoolIds && Array.isArray(s.quizPoolIds)) {
          quizPool = s.quizPoolIds.map(id => vocabList.find(v => v.id === id)).filter(Boolean);
        }

        document.getElementById("speedRateText").textContent = `${speechRate}x`;
        document.getElementById("autoAudioIcon").className = autoAudio ? "fa-solid fa-volume-high" : "fa-solid fa-volume-xmark";
        document.getElementById("chkQuizAutoNext").checked = quizAutoNext;
        document.getElementById("quizDirectionSelect").value = quizDirection;
        document.getElementById("chkOnlyMistakes").checked = onlyMistakesFilter;

        const tabToOpen = s.activeTab || "dashboard";
        switchActiveTab(tabToOpen);
        return true;
      } catch (e) {
        return false;
      }
    }

    function switchActiveTab(tabName) {
      currentActiveTab = tabName;
      document.querySelectorAll(".mode-tab").forEach(b => {
        if (b.getAttribute("data-tab") === tabName) {
          b.className = "mode-tab active shrink-0 px-3 py-1.5 rounded-xl text-xs font-bold bg-teal-600 text-white shadow-sm flex items-center gap-1.5 transition";
