    function analyzeSyllabus(text) {
        const lower = text.toLowerCase();
        
        parsedSyllabusWords = vocabList.filter(v => {
            const cleanWord = v.word.toLowerCase().split("/")[0].trim().replace(/\([^)]*\)/g, "").trim();
            return lower.includes(cleanWord) || lower.includes(v.meaning.toLowerCase());
        });
        
        cbtMatchedCountBadge.textContent = `Khớp ${parsedSyllabusWords.length} thuật ngữ`;
        if(parsedSyllabusWords.length > 0) {
            cbtMatchedWordsPreview.textContent = "Các từ nhận diện được: " + parsedSyllabusWords.map(v => v.word).join(", ");
        } else {
            cbtMatchedWordsPreview.textContent = "Không tìm thấy thuật ngữ chuyên ngành nào khớp với hệ thống dữ liệu hiện tại.";
        }
    }


    function saveCBTState() {
      if (cbtPool.length > 0 && cbtTimeLeft > 0) {
        localStorage.setItem(STORAGE_KEY_CBT_STATE, JSON.stringify({
          cbtPool, cbtAnswers, cbtFlags, cbtCurrentIndex, cbtTimeLeft, cbtTotalQuestions
        }));
      } else {
        localStorage.removeItem(STORAGE_KEY_CBT_STATE);
      }
    }

    function restoreCBTState() {
      const raw = localStorage.getItem(STORAGE_KEY_CBT_STATE);
      if (!raw) return;
      try {
        const cbtObj = JSON.parse(raw);
        if (cbtObj.cbtPool && cbtObj.cbtPool.length > 0 && cbtObj.cbtTimeLeft > 0) {
          cbtPool = cbtObj.cbtPool;
          cbtAnswers = cbtObj.cbtAnswers || {};
          cbtFlags = cbtObj.cbtFlags || {};
          cbtCurrentIndex = cbtObj.cbtCurrentIndex || 0;
          cbtTimeLeft = cbtObj.cbtTimeLeft;
          cbtTotalQuestions = cbtObj.cbtTotalQuestions || cbtPool.length;

          document.getElementById("cbtSetupView").classList.add("hidden");
          document.getElementById("cbtResultView").classList.add("hidden");
          document.getElementById("cbtExamView").classList.remove("hidden");

          updateCBTTimerDisplay();
          clearInterval(cbtTimerInterval);
          cbtTimerInterval = setInterval(() => {
            cbtTimeLeft--; updateCBTTimerDisplay(); saveCBTState();
            if (cbtTimeLeft <= 0) {
              clearInterval(cbtTimerInterval);
              showToast("Đã hết thời gian làm bài! Hệ thống tự động thu bài.", "error");
              submitCBTExam();
            }
          }, 1000);
          renderCBTQuestion();
        }
      } catch (e) {}
    }

