    function submitCBTExam() {
      clearInterval(cbtTimerInterval);
      cbtTimerInterval = null;
      localStorage.removeItem(STORAGE_KEY_CBT_STATE);

      document.getElementById("cbtExamView").classList.add("hidden");
      document.getElementById("cbtResultView").classList.remove("hidden");

      let correct = 0;
      const mistakes = [];
      const unitStats = {};
      let changesMade = false;

      cbtPool.forEach((q, idx) => {
        if (!unitStats[q.unit]) unitStats[q.unit] = { total: 0, right: 0 };
        unitStats[q.unit].total++;

        const realItem = vocabList.find(v => v.id === q.id);
        const userAnsObj = q.lockedOptions.find(o => o.id === cbtAnswers[idx]);
        const userAnsText = userAnsObj ? (q.qType === "en-vi" ? userAnsObj.meaning : userAnsObj.word) : "Bỏ trống";
        const correctAnsText = q.qType === "en-vi" ? q.meaning : q.word;

        if (cbtAnswers[idx] === q.id) {
          correct++;
          unitStats[q.unit].right++;
          if (realItem) { updateOutcomeMemoryOnly(realItem, true); changesMade = true; }
        } else {
          mistakes.push({ ...q, userAnsText, correctAnsText });
          if (realItem) { updateOutcomeMemoryOnly(realItem, false); changesMade = true; }
        }
      });

      if (changesMade) saveDatabase();

      const score10 = ((correct / cbtTotalQuestions) * 10).toFixed(1);
      document.getElementById("cbtFinalScore").textContent = `${score10} / 10 (${correct}/${cbtTotalQuestions} câu)`;
      localStorage.setItem(STORAGE_KEY_CBT_HISTORY, score10);

      const gradeEl = document.getElementById("cbtGradeBadge");
      const fbEl = document.getElementById("cbtFeedbackText");
      if (score10 >= 8.5) {
        gradeEl.textContent = "Xếp loại: XUẤT SẮC"; fbEl.textContent = "Sẵn sàng cho kỳ thi thật!";
      } else if (score10 >= 7.0) {
        gradeEl.textContent = "Xếp loại: KHÁ - GIỎI"; fbEl.textContent = "Nền tảng tốt! Hãy xem lại các lỗi nhỏ bên dưới.";
      } else if (score10 >= 5.0) {
        gradeEl.textContent = "Xếp loại: ĐẠT"; fbEl.textContent = "Cần củng cố thêm các học phần có tỷ lệ đúng thấp.";
      } else {
        gradeEl.textContent = "Xếp loại: CẦN ÔN LẠI"; fbEl.textContent = "Hãy dùng nút 'Ôn lại ngay' để vá lỗ hổng kiến thức.";
      }

      const breakdownList = document.getElementById("cbtUnitBreakdownList");
      breakdownList.innerHTML = "";
      Object.keys(unitStats).forEach(uName => {
        const st = unitStats[uName];
        const pct = Math.round((st.right / st.total) * 100);
        breakdownList.innerHTML += `
          <div class="flex items-center justify-between gap-2">
            <span class="font-bold text-slate-700 dark:text-slate-300">${uName}: ${st.right}/${st.total} câu (${pct}%)</span>
            <div class="w-36 h-2 rounded-full bg-slate-200 dark:bg-slate-700 overflow-hidden">
              <div class="h-full ${pct >= 75 ? "bg-emerald-500" : (pct >= 50 ? "bg-amber-500" : "bg-rose-500")}" style="width:${pct}%"></div>
            </div>
          </div>`;
      });

      const gapBox = document.getElementById("cbtGapAnalysis");
      const mistakeListEl = document.getElementById("cbtMistakeList");
      const btnReviewMistakes = document.getElementById("btnCBTReviewMistakes");
      mistakeListEl.innerHTML = "";

      if (mistakes.length > 0) {
        gapBox.classList.remove("hidden");
        btnReviewMistakes.classList.remove("hidden");
        mistakes.forEach(m => {
          mistakeListEl.innerHTML += `<li><strong>${m.word}</strong>: Bạn chọn: <span class="text-rose-500 line-through">${m.userAnsText}</span> ➔ Đáp án đúng: <span class="text-emerald-600">${m.correctAnsText}</span> <span class="text-[10px] opacity-75">[${m.unit}]</span></li>`;
        });
      } else {
        gapBox.classList.add("hidden");
        btnReviewMistakes.classList.add("hidden");
      }
    }

