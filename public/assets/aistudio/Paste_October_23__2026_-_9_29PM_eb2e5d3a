    function recordStudyOutcome(item, isCorrect) {
      if (!item) return;
      if (isCorrect) {
        if ((item.mistakeCount || 0) > 0) item.mistakeCount--;
        if ((item.mistakeCount || 0) === 0) {
          item.srsLevel = Math.min(3, Math.max(2, (item.srsLevel || 0) + 1));
        }
      } else {
        item.mistakeCount = (item.mistakeCount || 0) + 1;
        item.srsLevel = 1;
      }
      saveDatabase();
    }
    
    function updateOutcomeMemoryOnly(item, isCorrect) {
      if (!item) return;
      if (isCorrect) {
        if ((item.mistakeCount || 0) > 0) item.mistakeCount--;
        if ((item.mistakeCount || 0) === 0) {
          item.srsLevel = Math.min(3, Math.max(2, (item.srsLevel || 0) + 1));
        }
      } else {
        item.mistakeCount = (item.mistakeCount || 0) + 1;
        item.srsLevel = 1;
      }
    }

    function getDistinctDistractors(targetItem, count = 3) {
      const dist = [];
      const usedWords = new Set([targetItem.word.toLowerCase().split("/")[0].trim()]);
      const usedMeanings = new Set([targetItem.meaning.toLowerCase().trim()]);
      const candidates = [...vocabList].sort((a, b) => (b.pos === targetItem.pos ? 1 : 0) - (a.pos === targetItem.pos ? 1 : 0) || Math.random() - 0.5);
      
      for (const c of candidates) {
        if (dist.length >= count) break;
        const w = c.word.toLowerCase().split("/")[0].trim();
        const m = c.meaning.toLowerCase().trim();
        if (c.id !== targetItem.id && !usedWords.has(w) && !usedMeanings.has(m)) {
          dist.push(c); usedWords.add(w); usedMeanings.add(m);
        }
      }
      return dist;
    }

    function maskWordInSentence(sentence, rawWord) {
      if (!sentence || !rawWord) return sentence || "";
      let masked = sentence;
      const variants = [];
      rawWord.split("/").forEach(part => {
        const noParen = part.replace(/\([^)]*\)/g, "").trim();
        if (noParen) variants.push(noParen);
        const match = part.match(/\(([^)]+)\)/);
        if (match && match[1]) variants.push(match[1].trim());
      });
      variants.sort((a, b) => b.length - a.length).forEach(v => {
        if (v.length >= 2) {
          const escaped = v.replace(/[.*+?^${}()|[\]\\]/g, "\\$&");
          masked = masked.replace(new RegExp(escaped, "gi"), "[_____]");
        }
      });
      return masked;
    }

