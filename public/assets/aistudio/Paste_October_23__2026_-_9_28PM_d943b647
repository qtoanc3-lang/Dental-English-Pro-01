<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
  <meta http-equiv="Cache-Control" content="no-cache, no-store, must-revalidate" />
  <meta http-equiv="Pragma" content="no-cache" />
  <meta http-equiv="Expires" content="0" />
  <meta name="author" content="Quốc Toản" />
  <meta name="specialty" content="Răng Hàm Mặt" />
  <meta name="copyright" content="© 2026 Quốc Toản" />
  <meta name="description" content="Ứng dụng được xây dựng nhằm hỗ trợ học tập, nâng cao vốn thuật ngữ tiếng Anh chuyên ngành Răng Hàm Mặt và Y khoa." />
  <meta name="theme-color" content="#0d9488" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
  <meta name="apple-mobile-web-app-title" content="Dental English Pro" />
  <title>Dental English Pro — Tác giả: Quốc Toản</title>

  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          colors: {
            dental: {
              50: '#f0fdfa', 100: '#ccfbf1', 500: '#14b8a6',
              600: '#0d9488', 700: '#0f766e', 800: '#115e59', 900: '#134e4a',
            }
          }
        }
      }
    }
  </script>
  <!-- Thư viện hỗ trợ đọc file .DOCX và .PDF trực tiếp trên trình duyệt -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/mammoth/1.6.0/mammoth.browser.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/2.16.105/pdf.min.js"></script>
  <script>
    // Thiết lập worker cho PDF.js
    pdfjsLib.GlobalWorkerOptions.workerSrc = 'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/2.16.105/pdf.worker.min.js';
  </script>
  
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap');
    body { font-family: 'Inter', sans-serif; -webkit-tap-highlight-color: transparent; }
    .perspective-1000 { perspective: 1000px; }
    .transform-style-3d { transform-style: preserve-3d; }
    .backface-hidden { backface-visibility: hidden; }
    .rotate-y-180 { transform: rotateY(180deg); }
    .no-transition { transition: none !important; }
    ::-webkit-scrollbar { width: 5px; height: 5px; }
    ::-webkit-scrollbar-track { background: transparent; }
    ::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 9999px; }
    .dark ::-webkit-scrollbar-thumb { background: #475569; }
    @keyframes pulseGlow {
      0%, 100% { box-shadow: 0 0 0 0 rgba(20, 184, 166, 0.45); }
      50% { box-shadow: 0 0 0 6px rgba(20, 184, 166, 0); }
    }
    .pulse-arrow { animation: pulseGlow 2s infinite; }
    .collapse-content { overflow: hidden; transition: max-height 0.3s ease-in-out, opacity 0.3s ease-in-out; max-height: 0; opacity: 0; }
    .collapse-content.expanded { max-height: 500px; opacity: 1; }
  </style>
</head>
<body class="bg-slate-50 text-slate-800 dark:bg-slate-900 dark:text-slate-100 min-h-screen flex flex-col transition-colors duration-200">

  <!-- HỆ THỐNG TOAST THÔNG BÁO -->
  <div id="toastContainer" class="fixed top-4 right-4 z-[60] flex flex-col gap-2 max-w-sm w-[90%] pointer-events-none"></div>

  <!-- HEADER CHÍNH -->
  <header class="bg-white/95 dark:bg-slate-800/95 backdrop-blur sticky top-0 z-40 border-b border-slate-200 dark:border-slate-700 shadow-sm">
    <div class="max-w-5xl mx-auto px-3.5 sm:px-6 py-2.5">
      <div class="flex flex-wrap items-center justify-between gap-2">
        <div class="flex items-center gap-2.5">
          <div id="headerSpecIconBox" class="w-10 h-10 rounded-2xl bg-gradient-to-tr from-teal-600 to-cyan-500 flex items-center justify-center text-white shadow-md shadow-teal-500/20 shrink-0">
            <i id="headerSpecIcon" class="fa-solid fa-tooth text-lg"></i>
          </div>
          <div>
            <div class="flex flex-wrap items-center gap-1.5 sm:gap-2">
              <h1 class="font-extrabold text-base sm:text-lg tracking-tight text-slate-900 dark:text-white">Dental English Pro</h1>
              <button id="btnOpenSpecialtyModal" title="Đổi hoặc thêm chuyên ngành mới" class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-bold bg-cyan-50 hover:bg-cyan-100 text-cyan-800 dark:bg-cyan-950/80 dark:text-cyan-300 border border-cyan-200 dark:border-cyan-800 transition">
                <span id="currentSpecialtyName">Răng Hàm Mặt</span>
                <i class="fa-solid fa-chevron-down text-[9px]"></i>
              </button>
            </div>

            <div class="flex flex-wrap items-center gap-1.5 mt-0.5">
              <span id="headerDbBadge" class="inline-block text-[11px] font-bold px-2 py-0.5 rounded-md bg-teal-100/80 dark:bg-teal-900/50 text-teal-800 dark:text-teal-300">
                Đang tải...
              </span>
              <span id="srsSummaryBadge" class="inline-block text-[10px] font-semibold px-2 py-0.5 rounded-md bg-amber-100/80 dark:bg-amber-950/60 text-amber-800 dark:text-amber-300">
                SRS: 0 thuộc
              </span>
            </div>
          </div>
        </div>

        <div class="flex items-center gap-1.5 ml-auto">
          <button id="btnOpenGuideModal" title="Cẩm nang hướng dẫn sử dụng toàn bộ chế độ & tính năng" class="px-2.5 py-1.5 rounded-xl text-xs font-bold bg-indigo-50 hover:bg-indigo-100 dark:bg-indigo-950/80 dark:hover:bg-indigo-900/70 text-indigo-700 dark:text-indigo-300 border border-indigo-200 dark:border-indigo-800 flex items-center gap-1.5 transition">
            <i class="fa-solid fa-book-open-reader"></i>
            <span class="hidden sm:inline">Hướng dẫn</span>
          </button>
          <button id="btnOpenAiHub" title="Trợ lý AI Toàn diện (3 tầng chống lỗi)" class="px-2.5 py-1.5 rounded-xl text-xs font-bold bg-gradient-to-r from-teal-600 to-cyan-600 hover:brightness-110 text-white shadow-sm flex items-center gap-1.5 transition">
            <i class="fa-solid fa-robot"></i>
            <span class="hidden sm:inline">Trợ lý AI</span>
            <span id="aiStatusDot" class="w-2 h-2 rounded-full bg-emerald-300"></span>
          </button>
          <button id="btnSpeedRate" title="Tốc độ đọc âm thanh" class="px-2.5 py-1.5 rounded-xl text-xs font-bold bg-slate-100 dark:bg-slate-700 text-slate-700 dark:text-slate-200 hover:bg-teal-50 dark:hover:bg-slate-600 transition flex items-center gap-1">
            <i class="fa-solid fa-gauge-high text-teal-600 dark:text-teal-400"></i>
            <span id="speedRateText">1.0x</span>
          </button>
          <button id="btnAutoAudioToggle" title="Bật/Tắt tự động phát âm" class="p-2 rounded-xl text-xs font-bold bg-teal-50 dark:bg-teal-950/80 text-teal-600 dark:text-teal-400 border border-teal-200 dark:border-teal-800 transition">
            <i id="autoAudioIcon" class="fa-solid fa-volume-high"></i>
          </button>
          <button id="btnInstallPwa" title="Hướng dẫn cài App ra màn hình chính" class="px-2.5 py-1.5 rounded-xl text-xs font-semibold bg-amber-50 dark:bg-amber-950/60 text-amber-700 dark:text-amber-300 border border-amber-200 dark:border-amber-800/80 hover:bg-amber-100 transition flex items-center gap-1">
            <i class="fa-solid fa-mobile-screen-button"></i>
            <span class="hidden md:inline">Cài App</span>
          </button>
          <button id="btnOpenJsonModal" title="Sao lưu / Nạp JSON" class="p-2 rounded-xl bg-slate-100 dark:bg-slate-700 text-amber-600 dark:text-amber-400 hover:bg-slate-200 transition">
            <i class="fa-solid fa-database text-xs"></i>
          </button>
          <button id="btnTheme" title="Chế độ Sáng / Tối" class="p-2 rounded-xl bg-slate-100 dark:bg-slate-700 text-slate-600 dark:text-slate-300 hover:bg-slate-200 transition">
            <i id="themeIcon" class="fa-solid fa-moon text-xs"></i>
          </button>
        </div>
      </div>

      <!-- Thanh Tabs Chế Độ Học -->
      <nav class="flex items-center gap-1 sm:gap-2 overflow-x-auto pt-2.5 mt-2 border-t border-slate-100 dark:border-slate-700/70 no-scrollbar">
        <button class="mode-tab active shrink-0 px-3 py-1.5 rounded-xl text-xs font-bold bg-teal-600 text-white shadow-sm flex items-center gap-1.5 transition" data-tab="dashboard">
          <i class="fa-solid fa-chart-pie"></i> 0. Tổng Quan & Tiến Trình
        </button>
        <button class="mode-tab shrink-0 px-3 py-1.5 rounded-xl text-xs font-semibold text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-700 flex items-center gap-1.5 transition" data-tab="quiz">
          <i class="fa-solid fa-list-check"></i> 1. Trắc Nghiệm
        </button>
        <button class="mode-tab shrink-0 px-3 py-1.5 rounded-xl text-xs font-semibold text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-700 flex items-center gap-1.5 transition" data-tab="flashcard">
          <i class="fa-solid fa-clone"></i> 2. Flashcard 3D (SRS)
        </button>
        <button class="mode-tab shrink-0 px-3 py-1.5 rounded-xl text-xs font-semibold text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-700 flex items-center gap-1.5 transition" data-tab="dictation">
          <i class="fa-solid fa-headphones"></i> 3. Chép Chính Tả
        </button>
        <button class="mode-tab shrink-0 px-3 py-1.5 rounded-xl text-xs font-semibold text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-700 flex items-center gap-1.5 transition" data-tab="sprint">
          <i class="fa-solid fa-bolt"></i> 4. Đua Tốc Độ 60s
        </button>
        <button class="mode-tab shrink-0 px-3 py-1.5 rounded-xl text-xs font-semibold text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-700 flex items-center gap-1.5 transition" data-tab="manage">
          <i class="fa-solid fa-folder-tree"></i> 5. Cây Thư Mục & Nhập Liệu
        </button>
        <button class="mode-tab shrink-0 px-3 py-1.5 rounded-xl text-xs font-semibold text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-700 flex items-center gap-1.5 transition" data-tab="cbt">
          <i class="fa-solid fa-laptop-medical"></i> 6. Thi Thử CBT
        </button>
      </nav>
    </div>
  </header>

  <!-- MAIN APP -->
  <main class="flex-1 max-w-5xl w-full mx-auto px-3.5 sm:px-6 py-4 space-y-4">
    <!-- TAB 0: TỔNG QUAN & TIẾN TRÌNH HỌC TẬP (DASHBOARD CHÍNH) -->
    <section id="tab-dashboard" class="tab-panel space-y-4">
      <!-- Thẻ chào mừng & Chuỗi ngày học liên tục (Streak) -->
      <div class="relative overflow-hidden rounded-3xl bg-gradient-to-br from-teal-700 via-teal-800 to-slate-900 text-white p-5 sm:p-7 shadow-lg">
        <div class="relative z-10 flex flex-col md:flex-row items-start md:items-center justify-between gap-4">
          <div class="space-y-1.5 max-w-lg">
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/10 backdrop-blur text-teal-200 text-xs font-bold border border-white/10">
              <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
              <span id="dashCurrentSpecialtyTag">Chuyên ngành: Răng Hàm Mặt</span>
            </div>
            <h2 class="text-xl sm:text-2xl font-black tracking-tight text-white">Trung Tâm Quản Lý & Tiến Trình Học Tập</h2>
            <p class="text-xs sm:text-sm text-teal-100/90 leading-relaxed">
              Theo dõi độ ghi nhớ theo thuật toán lặp lại ngắt quãng (SRS), chuỗi ngày học tập, khám phá chi tiết từng học phần và hướng dẫn sử dụng toàn diện.
            </p>
          </div>

          <div class="flex items-center gap-3 bg-white/10 backdrop-blur border border-white/15 px-4 py-3 rounded-2xl shrink-0">
            <div class="w-12 h-12 rounded-2xl bg-amber-400/20 text-amber-300 flex items-center justify-center text-2xl">
              <i class="fa-solid fa-fire-flame-curved animate-pulse"></i>
            </div>
            <div>
              <p class="text-[10px] font-extrabold uppercase tracking-wider text-teal-200">Chuỗi Ngày Học (Streak)</p>
              <div class="flex items-baseline gap-1.5">
                <span id="dashStreakDays" class="text-2xl font-black text-white">1</span>
                <span class="text-xs text-amber-300 font-bold">ngày liên tục</span>
              </div>
              <p id="dashStreakHint" class="text-[10px] text-teal-100/80">Học mỗi ngày để giữ ngọn lửa!</p>
            </div>
          </div>
        </div>

        <div class="absolute -right-8 -bottom-10 opacity-10 text-9xl text-white pointer-events-none select-none">
          <i class="fa-solid fa-brain"></i>
        </div>
      </div>

      <!-- 4 Khối Chỉ Số Tổng Quan (Metrics Grid) -->
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-3">
        <div class="bg-white dark:bg-slate-800 p-4 rounded-2xl border border-slate-200 dark:border-slate-700 shadow-sm flex items-center gap-3.5">
          <div class="w-11 h-11 rounded-2xl bg-teal-50 dark:bg-teal-950/80 text-teal-600 dark:text-teal-400 flex items-center justify-center text-lg shrink-0">
            <i class="fa-solid fa-book-bookmark"></i>
          </div>
          <div class="min-w-0">
            <p class="text-[10px] font-extrabold uppercase tracking-wider text-slate-400">Tổng Thuật Ngữ</p>
            <h3 id="dashTotalWords" class="text-xl font-black text-slate-900 dark:text-white">0</h3>
            <p id="dashUnitCountText" class="text-[11px] text-slate-500 truncate">0 Học phần</p>
          </div>
        </div>

        <div class="bg-white dark:bg-slate-800 p-4 rounded-2xl border border-slate-200 dark:border-slate-700 shadow-sm flex items-center gap-3.5">
          <div class="w-11 h-11 rounded-2xl bg-emerald-50 dark:bg-emerald-950/80 text-emerald-600 dark:text-emerald-400 flex items-center justify-center text-lg shrink-0">
            <i class="fa-solid fa-circle-check"></i>
          </div>
          <div class="min-w-0">
            <p class="text-[10px] font-extrabold uppercase tracking-wider text-emerald-600 dark:text-emerald-400">Đã Thuộc Lầu (SRS)</p>
            <h3 id="dashMasteredWords" class="text-xl font-black text-emerald-600 dark:text-emerald-400">0</h3>
            <p id="dashMasteredPct" class="text-[11px] text-slate-500 font-semibold">0% kho từ vựng</p>
          </div>
        </div>

        <div class="bg-white dark:bg-slate-800 p-4 rounded-2xl border border-slate-200 dark:border-slate-700 shadow-sm flex items-center gap-3.5">
          <div class="w-11 h-11 rounded-2xl bg-amber-50 dark:bg-amber-950/80 text-amber-600 dark:text-amber-400 flex items-center justify-center text-lg shrink-0">
            <i class="fa-solid fa-hourglass-half"></i>
          </div>
          <div class="min-w-0">
            <p class="text-[10px] font-extrabold uppercase tracking-wider text-amber-600 dark:text-amber-400">Đang Ghi Nhớ</p>
            <h3 id="dashLearningWords" class="text-xl font-black text-amber-600 dark:text-amber-400">0</h3>
            <p class="text-[11px] text-slate-500">Cần ôn định kỳ</p>
          </div>
        </div>

        <div class="bg-white dark:bg-slate-800 p-4 rounded-2xl border border-slate-200 dark:border-slate-700 shadow-sm flex items-center gap-3.5">
          <div class="w-11 h-11 rounded-2xl bg-rose-50 dark:bg-rose-950/80 text-rose-600 dark:text-rose-400 flex items-center justify-center text-lg shrink-0">
            <i class="fa-solid fa-triangle-exclamation"></i>
          </div>
          <div class="min-w-0">
            <p class="text-[10px] font-extrabold uppercase tracking-wider text-rose-600 dark:text-rose-400">Từ Chưa Thuộc / Sai</p>
            <h3 id="dashMistakeWords" class="text-xl font-black text-rose-600 dark:text-rose-400">0</h3>
            <p class="text-[11px] text-slate-500">Cần cấp cứu ôn tập</p>
          </div>
        </div>
      </div>

      <!-- Phân Tích Ma Trận Bộ Nhớ SRS & Phím Tắt Luyện Tập Nhanh -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <!-- Ma trận cấp độ nhớ SRS -->
        <div class="md:col-span-2 bg-white dark:bg-slate-800 p-5 rounded-2xl border border-slate-200 dark:border-slate-700 shadow-sm space-y-4">
          <div class="flex items-center justify-between pb-2 border-b border-slate-100 dark:border-slate-700">
            <h3 class="font-extrabold text-sm flex items-center gap-2">
              <i class="fa-solid fa-layer-group text-teal-600"></i> Phân Bổ Mức Độ Thuộc Bài (SRS Memory Levels)
            </h3>
            <div class="flex items-center gap-2">
              <button id="btnResetProgress" class="hidden sm:flex text-[10px] font-bold px-2 py-1 rounded-lg bg-rose-50 dark:bg-rose-950/60 text-rose-600 dark:text-rose-400 border border-rose-200 dark:border-rose-800 hover:bg-rose-100 transition items-center gap-1">
                <i class="fa-solid fa-rotate-left"></i> Đặt lại
              </button>
              <span id="dashOverallScoreBadge" class="text-xs font-black px-2.5 py-0.5 rounded-full bg-teal-50 dark:bg-teal-950 text-teal-700 dark:text-teal-300">
                Độ bao phủ: 0%
              </span>
            </div>
          </div>

          <!-- Thanh tiến độ tổng hợp nhiều màu -->
          <div class="space-y-1.5">
            <div class="flex justify-between text-xs font-semibold text-slate-600 dark:text-slate-300">
              <span>Tiến độ ghi nhớ toàn diện</span>
              <span id="dashSrsRatioText">0 / 0 từ</span>
            </div>
            <div class="w-full h-3.5 rounded-full bg-slate-100 dark:bg-slate-700 overflow-hidden flex">
              <div id="barSrsMastered" class="bg-emerald-500 h-full transition-all duration-500" style="width: 0%" title="Thành thạo"></div>
              <div id="barSrsLearning" class="bg-amber-400 h-full transition-all duration-500" style="width: 0%" title="Đang nhớ"></div>
              <div id="barSrsHard" class="bg-rose-500 h-full transition-all duration-500" style="width: 0%" title="Chưa thuộc"></div>
            </div>
          </div>

          <!-- Chi tiết 4 trạng thái SRS -->
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-2 pt-1 text-xs">
            <div class="p-2.5 rounded-xl bg-emerald-50/70 dark:bg-emerald-950/40 border border-emerald-200 dark:border-emerald-800/60">
              <span class="text-[10px] font-bold text-emerald-700 dark:text-emerald-300 flex items-center gap-1">
                <span class="w-2 h-2 rounded-full bg-emerald-500"></span> Cấp 3: Thành thạo
              </span>
              <p id="srsLvl3Count" class="text-base font-black text-emerald-800 dark:text-emerald-200 mt-1">0</p>
            </div>
            <div class="p-2.5 rounded-xl bg-amber-50/70 dark:bg-amber-950/40 border border-amber-200 dark:border-amber-800/60">
              <span class="text-[10px] font-bold text-amber-700 dark:text-amber-300 flex items-center gap-1">
                <span class="w-2 h-2 rounded-full bg-amber-500"></span> Cấp 2: Đang nhớ
              </span>
              <p id="srsLvl2Count" class="text-base font-black text-amber-800 dark:text-amber-200 mt-1">0</p>
            </div>
            <div class="p-2.5 rounded-xl bg-rose-50/70 dark:bg-rose-950/40 border border-rose-200 dark:border-rose-800/60">
              <span class="text-[10px] font-bold text-rose-700 dark:text-rose-300 flex items-center gap-1">
                <span class="w-2 h-2 rounded-full bg-rose-500"></span> Cấp 1: Chưa thuộc
              </span>
              <p id="srsLvl1Count" class="text-base font-black text-rose-800 dark:text-rose-200 mt-1">0</p>
            </div>
            <div class="p-2.5 rounded-xl bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-700">
              <span class="text-[10px] font-bold text-slate-500 flex items-center gap-1">
                <span class="w-2 h-2 rounded-full bg-slate-400"></span> Cấp 0: Chưa học
              </span>
              <p id="srsLvl0Count" class="text-base font-black text-slate-700 dark:text-slate-300 mt-1">0</p>
            </div>
          </div>
        </div>

        <!-- Khung hành động học tập nhanh -->
        <div class="bg-white dark:bg-slate-800 p-5 rounded-2xl border border-slate-200 dark:border-slate-700 shadow-sm flex flex-col justify-between space-y-3">
          <div>
            <h3 class="font-extrabold text-sm flex items-center gap-2 pb-2 border-b border-slate-100 dark:border-slate-700">
              <i class="fa-solid fa-bolt text-amber-500"></i> Lối Tắt Học Nhanh
            </h3>
            <p class="text-xs text-slate-500 mt-1.5 leading-relaxed">Tiếp tục phiên học theo mục tiêu của bạn:</p>
          </div>

          <div class="space-y-2">
            <button id="btnDashQuickMistakes" type="button" class="w-full py-2.5 px-3 rounded-xl bg-rose-50 hover:bg-rose-100 dark:bg-rose-950/60 dark:hover:bg-rose-900/60 text-rose-700 dark:text-rose-300 text-xs font-bold border border-rose-200 dark:border-rose-800 flex items-center justify-between transition">
              <span class="flex items-center gap-2"><i class="fa-solid fa-fire text-rose-500"></i> Ôn ngay các từ hay sai</span>
