    function toggleUnitDetail(unitName, btnElement) {
      const isExpanded = expandedUnitDetails.has(unitName);
      const safeKey = unitName.replace(/\s+/g, '');
      const boxIds = [`detailBox_${safeKey}`, `dashDetailBox_${safeKey}`, `treeDetailBox_${safeKey}`];

      if (isExpanded) {
        expandedUnitDetails.delete(unitName);
      } else {
        expandedUnitDetails.add(unitName);
      }

      const nextState = expandedUnitDetails.has(unitName);
      if (btnElement) {
        const icon = btnElement.querySelector('i');
        if (icon) icon.style.transform = nextState ? "rotate(180deg)" : "rotate(0deg)";
      }

      document.querySelectorAll(`[data-dash-toggle-unit="${unitName}"] i, [data-tree-toggle-unit="${unitName}"] i`).forEach(ic => {
        ic.style.transform = nextState ? "rotate(180deg)" : "rotate(0deg)";
      });

      boxIds.forEach(id => {
        const el = document.getElementById(id);
        if (el) el.classList.toggle('expanded', nextState);
      });
    }

3. Vá toàn bộ cụm logic Tab 7 (Từ dòng 1909 đến dòng 2239):
Thay thế toàn bộ phần CHẾ ĐỘ 7: QUÉT TÀI LIỆU PDF/SLIDE... bằng đoạn mã đã bọc chống lỗi kéo-thả, tách biệt nút bấm Kết quả Thi vs Trích xuất Từ, chống lỗi nháy đơn và chống NaN%:
      // ==========================================
      // CHẾ ĐỘ 7: QUÉT TÀI LIỆU PDF/SLIDE TẠO ĐỀ THI TỰ ĐỘNG (AI DOCUMENT EXAM STUDIO)
      // ==========================================
      let docExamPool = [];
      let docExamCurrentIndex = 0;
      let docExamAnswers = {};
      let docExamTimerInterval = null;
      let docExamTimeLeft = 600;
      let docExtractedVocabList = [];

      const docExamDropZone = document.getElementById("docExamDropZone");
      const docExamFileInput = document.getElementById("docExamFileInput");
      const btnSelectDocFile = document.getElementById("btnSelectDocFile");
      const btnClearDocFile = document.getElementById("btnClearDocFile");
      const docUploadedNameBadge = document.getElementById("docUploadedNameBadge");

      btnSelectDocFile.onclick = () => docExamFileInput.click();
      btnClearDocFile.onclick = () => {
        docExamFileInput.value = "";
        btnClearDocFile.classList.add("hidden");
        docUploadedNameBadge.classList.add("hidden");
        document.getElementById("docExamTextInput").value = "";
        showToast("Đã xóa file tải lên", "info");
      };

      // Bổ sung sự kiện Kéo & Thả (Drag & Drop) cho Tab 7
      if (docExamDropZone) {
        docExamDropZone.addEventListener("dragover", e => {
          e.preventDefault();
          docExamDropZone.classList.add("border-indigo-500", "bg-indigo-100/70");
        });
        docExamDropZone.addEventListener("dragleave", e => {
          e.preventDefault();
          docExamDropZone.classList.remove("border-indigo-500", "bg-indigo-100/70");
        });
        docExamDropZone.addEventListener("drop", e => {
          e.preventDefault();
          docExamDropZone.classList.remove("border-indigo-500", "bg-indigo-100/70");
          if (e.dataTransfer.files && e.dataTransfer.files.length > 0) {
            docExamFileInput.files = e.dataTransfer.files;
            docExamFileInput.dispatchEvent(new Event("change"));
          }
        });
      }

      docExamFileInput.onchange = async e => {
        const file = e.target.files[0];
        if (!file) return;

        btnClearDocFile.classList.remove("hidden");
        docUploadedNameBadge.classList.remove("hidden");
        docUploadedNameBadge.textContent = `📄 Đã nạp file: ${file.name}`;

        const loadingBox = document.getElementById("docLoadingBox");
        loadingBox.classList.remove("hidden");
        document.getElementById("docLoadingStatusText").textContent = `Đang trích xuất văn bản từ ${file.name}...`;

        try {
          let text = "";
          const ext = file.name.split('.').pop().toLowerCase();
          if (['txt', 'csv', 'json', 'md'].includes(ext)) {
            text = await file.text();
          } else if (ext === 'docx') {
            if (typeof mammoth === "undefined") throw new Error("Thư viện đọc Word chưa sẵn sàng khi Offline.");
            const ab = await file.arrayBuffer();
            const res = await mammoth.extractRawText({ arrayBuffer: ab });
            text = res.value;
          } else if (ext === 'pdf') {
            if (typeof pdfjsLib === "undefined") throw new Error("Thư viện đọc PDF chưa sẵn sàng khi Offline.");
            const ab = await file.arrayBuffer();
            const pdf = await pdfjsLib.getDocument({ data: ab }).promise;
            for (let i = 1; i <= pdf.numPages; i++) {
              const page = await pdf.getPage(i);
              const content = await page.getTextContent();
              text += content.items.map(it => it.str).join(" ") + " ";
            }
          } else {
            throw new Error("Định dạng file chưa được hỗ trợ.");
          }

          document.getElementById("docExamTextInput").value = text.trim();
          showToast(`Trích xuất thành công ${text.trim().split(/\s+/).filter(Boolean).length} từ từ file!`, "success");
        } catch (err) {
          showToast(`Lỗi đọc file: ${err.message}`, "error");
        } finally {
          loadingBox.classList.add("hidden");
        }
      };

      // Sinh Đề Thi Trắc Nghiệm Bằng Gemini Cloud AI
      document.getElementById("btnDocGenerateExam").onclick = async () => {
        const rawContent = document.getElementById("docExamTextInput").value.trim();
        if (!rawContent) return showToast("Vui lòng tải file hoặc dán nội dung bài giảng!", "error");

        const loadingBox = document.getElementById("docLoadingBox");
        loadingBox.classList.remove("hidden");
        document.getElementById("docLoadingStatusText").textContent = "Gemini 2.5 Flash đang phân tích kiến thức và biên soạn đề thi 10 câu...";

        const apiKey = localStorage.getItem(STORAGE_KEY_AI_KEY);
        let examQuestions = [];

        if (apiKey) {
          const prompt = `Bạn là Giảng viên Đại học Y Dược chuyên ngành Răng Hàm Mặt. Dựa trên nội dung tài liệu sau đây:
"${rawContent.slice(0, 3500)}"

Hãy biên soạn chính xác 10 câu hỏi trắc nghiệm kiểm tra kiến thức lâm sàng và thuật ngữ tiếng Anh trong tài liệu.
Mỗi câu có 4 đáp án A, B, C, D (1 đáp án đúng và 3 đáp án gây nhiễu y khoa hợp lý), kèm giải thích tại sao đáp án đó đúng.
Trả về DUY NHẤT một mảng JSON hợp lệ không có markdown backticks:
[
  {
    "question": "Nội dung câu hỏi tiếng Anh hoặc ca bệnh lâm sàng",
    "options": ["Đáp án A", "Đáp án B", "Đáp án C", "Đáp án D"],
    "correctIndex": 0,
    "rationale": "Giải thích ngắn gọn 1-2 câu tiếng Việt chuyên ngành"
  }
]`;
          const models = ["gemini-2.5-flash", "gemini-2.0-flash", "gemini-1.5-flash-latest"];
          for (const m of models) {
            try {
              const res = await fetch(`https://generativelanguage.googleapis.com/v1beta/models/${m}:generateContent?key=${apiKey}`, {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ contents: [{ parts: [{ text: prompt }] }] })
              });
              const data = await res.json();
              const raw = data?.candidates?.[0]?.content?.parts?.[0]?.text;
              if (raw) {
                const clean = raw.replace(/```json/gi, "").replace(/```/g, "").trim();
                const parsed = JSON.parse(clean);
                if (Array.isArray(parsed) && parsed.length > 0) {
                  examQuestions = parsed.filter(q => q && q.question && Array.isArray(q.options) && q.options.length >= 2);
                  if (examQuestions.length > 0) break;
                }
              }
            } catch (e) {
              console.warn(`Lỗi gọi Gemini (${m}):`, e);
            }
          }
        }

        // Fallback tạo đề thông minh nếu không có API key
        if (!examQuestions || examQuestions.length === 0) {
          const matched = vocabList.filter(v => rawContent.toLowerCase().includes(v.word.toLowerCase().split("/")[0].trim()));
          const pool = matched.length >= 5 ? matched : vocabList;
          const shuffled = [...pool].sort(() => Math.random() - 0.5).slice(0, 10);
          examQuestions = shuffled.map(item => {
            const distractors = getDistinctDistractors(item, 3);
            const opts = [item.meaning, ...distractors.map(d => d.meaning)].sort(() => Math.random() - 0.5);
            return {
              question: `Thuật ngữ chuyên ngành nha khoa "${item.word}" (${item.ipa}) có ý nghĩa lâm sàng là gì?`,
              options: opts,
              correctIndex: Math.max(0, opts.indexOf(item.meaning)),
              rationale: `${item.word} có nghĩa là: ${item.meaning}. Ghi chú: ${item.clinicalNote}`
            };
          });
        }

        loadingBox.classList.add("hidden");
        if (examQuestions.length > 0) {
          docExamPool = examQuestions;
          docExamCurrentIndex = 0;
          docExamAnswers = {};
          docExamTimeLeft = docExamPool.length * 60;

          document.getElementById("docExamSetupView").classList.add("hidden");
          document.getElementById("docExamResultView").classList.add("hidden");
          document.getElementById("docExamPlayView").classList.remove("hidden");

          renderDocExamQuestion();
          updateDocExamTimer();
          clearInterval(docExamTimerInterval);
          docExamTimerInterval = setInterval(() => {
            if (currentActiveTab !== "docexam") return; // Tạm dừng đếm khi chuyển sang tab khác
            docExamTimeLeft--;
            updateDocExamTimer();
            if (docExamTimeLeft <= 0) {
              clearInterval(docExamTimerInterval);
              showToast("Hết giờ làm bài!", "error");
              submitDocExam();
            }
          }, 1000);
          showToast(`Đã tạo thành công đề thi ${docExamPool.length} câu!`, "success");
        } else {
          showToast("Không thể tạo đề từ nội dung này. Vui lòng kiểm tra lại tài liệu!", "error");
        }
      };

      function updateDocExamTimer() {
        const m = Math.max(0, Math.floor(docExamTimeLeft / 60));
        const s = Math.max(0, docExamTimeLeft % 60);
        document.getElementById("docExamTimerText").textContent = `${String(m).padStart(2, '0')}:${String(s).padStart(2, '0')}`;
      }

      function renderDocExamQuestion() {
        const q = docExamPool[docExamCurrentIndex];
        if (!q) return;

        document.getElementById("docExamCounterText").textContent = `Câu ${docExamCurrentIndex + 1}/${docExamPool.length}`;
        document.getElementById("docExamQuestionText").textContent = q.question;

        const container = document.getElementById("docExamOptionsContainer");
        container.innerHTML = "";
        const userChoice = docExamAnswers[docExamCurrentIndex];
        const rationaleBox = document.getElementById("docExamRationaleBox");

        if (userChoice !== undefined && q.rationale) {
          rationaleBox.textContent = `💡 Lời giải: ${q.rationale}`;
          rationaleBox.classList.remove("hidden");
        } else {
          rationaleBox.classList.add("hidden");
        }

        q.options.forEach((opt, optIdx) => {
          const btn = document.createElement("button");
          btn.type = "button";
          const isSelected = userChoice === optIdx;
          let btnCls = "p-3.5 rounded-xl border text-left text-xs sm:text-sm font-semibold transition flex items-center justify-between ";

          if (userChoice !== undefined) {
            if (optIdx === q.correctIndex) {
              btnCls += "bg-emerald-100 dark:bg-emerald-950/80 border-emerald-500 text-emerald-900 dark:text-emerald-200";
            } else if (isSelected) {
              btnCls += "bg-rose-100 dark:bg-rose-950/80 border-rose-500 text-rose-900 dark:text-rose-200";
            } else {
              btnCls += "bg-white dark:bg-slate-800 border-slate-200 dark:border-slate-700 opacity-60";
            }
          } else {
            btnCls += "bg-white dark:bg-slate-800 hover:bg-slate-50 dark:hover:bg-slate-700 border-slate-200 dark:border-slate-700 text-slate-800 dark:text-slate-100";
          }

          btn.className = btnCls;
          btn.innerHTML = `<span><strong>${String.fromCharCode(65 + optIdx)}.</strong> ${opt}</span>`;

          btn.onclick = () => {
            if (docExamAnswers[docExamCurrentIndex] !== undefined) return;
            docExamAnswers[docExamCurrentIndex] = optIdx;
            triggerHaptic(optIdx === q.correctIndex ? "success" : "error");
            renderDocExamQuestion();
          };
          container.appendChild(btn);
        });

        document.getElementById("btnDocExamPrev").disabled = docExamCurrentIndex === 0;
        document.getElementById("btnDocExamNext").disabled = docExamCurrentIndex === docExamPool.length - 1;
      }

      document.getElementById("btnDocExamPrev").onclick = () => {
        if (docExamCurrentIndex > 0) {
          docExamCurrentIndex--;
          renderDocExamQuestion();
        }
      };

      document.getElementById("btnDocExamNext").onclick = () => {
        if (docExamCurrentIndex < docExamPool.length - 1) {
          docExamCurrentIndex++;
          renderDocExamQuestion();
        }
      };

      function submitDocExam() {
        clearInterval(docExamTimerInterval);
        document.getElementById("docExamPlayView").classList.add("hidden");
        document.getElementById("docExamResultView").classList.remove("hidden");

        // Ẩn nút nạp từ vựng và hiện nút làm lại đề khi ở chế độ Chấm điểm thi
        document.getElementById("btnDocImportAllExtracted").classList.add("hidden");
        document.getElementById("btnDocRetryExam").classList.remove("hidden");

        let correct = 0;
        docExamPool.forEach((q, idx) => {
          if (docExamAnswers[idx] === q.correctIndex) correct++;
        });

        const totalQ = docExamPool.length || 1;
        const pct = Math.round((correct / totalQ) * 100);
        document.getElementById("docExamFinalScore").textContent = `Điểm số: ${correct} / ${docExamPool.length} câu đúng (${pct}%)`;
        const reviewBox = document.getElementById("docExtractedVocabReviewBox");
        reviewBox.innerHTML = "<p class='font-bold text-slate-700 dark:text-slate-200 mb-1'>Bảng đối chiếu câu hỏi & giải thích:</p>";
        docExamPool.forEach((q, idx) => {
          const isRight = docExamAnswers[idx] === q.correctIndex;
          reviewBox.innerHTML += `
            <div class="p-2.5 rounded-lg ${isRight ? "bg-emerald-50 dark:bg-emerald-950/40 text-emerald-800 dark:text-emerald-300" : "bg-rose-50 dark:bg-rose-950/40 text-rose-800 dark:text-rose-300"}">
              <p><strong>Câu ${idx + 1}:</strong> ${q.question}</p>
              <p class="text-[11px] mt-0.5">Đáp án đúng: <strong>${q.options[q.correctIndex]}</strong>. ${q.rationale || ""}</p>
            </div>
          `;
        });
      }

      document.getElementById("btnDocExamSubmit").onclick = () => {
        const answered = Object.keys(docExamAnswers).length;
        if (answered < docExamPool.length) {
          if (!confirm(`Bạn mới trả lời ${answered}/${docExamPool.length} câu. Bạn có chắc muốn nộp bài?`)) return;
        }
        submitDocExam();
      };

      document.getElementById("btnQuitDocExam").onclick = () => {
        clearInterval(docExamTimerInterval);
        document.getElementById("docExamPlayView").classList.add("hidden");
        document.getElementById("docExamSetupView").classList.remove("hidden");
      };

      document.getElementById("btnDocRetryExam").onclick = () => {
        if (!docExamPool || docExamPool.length === 0) return;
        docExamCurrentIndex = 0;
        docExamAnswers = {};
        docExamTimeLeft = docExamPool.length * 60;
        document.getElementById("docExamResultView").classList.add("hidden");
        document.getElementById("docExamPlayView").classList.remove("hidden");
        renderDocExamQuestion();
        updateDocExamTimer();
        clearInterval(docExamTimerInterval);
        docExamTimerInterval = setInterval(() => {
          if (currentActiveTab !== "docexam") return;
          docExamTimeLeft--;
          updateDocExamTimer();
          if (docExamTimeLeft <= 0) {
            clearInterval(docExamTimerInterval);
            submitDocExam();
          }
        }, 1000);
      };

      document.getElementById("btnDocNewExam").onclick = () => {
        document.getElementById("docExamResultView").classList.add("hidden");
        document.getElementById("docExamSetupView").classList.remove("hidden");
      };

      // Trích xuất từ vựng cốt lõi từ file
      document.getElementById("btnDocExtractVocab").onclick = async () => {
        const rawContent = document.getElementById("docExamTextInput").value.trim();
        if (!rawContent) return showToast("Vui lòng tải file hoặc dán nội dung bài giảng!", "error");

        const loadingBox = document.getElementById("docLoadingBox");
        loadingBox.classList.remove("hidden");
        document.getElementById("docLoadingStatusText").textContent = "Gemini 2.5 Flash đang trích xuất thuật ngữ Y Nha khoa từ tài liệu...";

        const apiKey = localStorage.getItem(STORAGE_KEY_AI_KEY);
        let extractedTerms = [];

        if (apiKey) {
          const prompt = `Bạn là chuyên gia từ điển Y Nha khoa quốc tế. Hãy đọc đoạn tài liệu sau và trích xuất ra 10 đến 15 thuật ngữ tiếng Anh chuyên ngành cốt lõi:
"${rawContent.slice(0, 3500)}"

Trả về DUY NHẤT một mảng JSON hợp lệ không kèm bất kỳ giải thích nào:
[
  {
    "word": "Thuật ngữ tiếng Anh",
    "ipa": "/phiên âm IPA/",
    "pos": "từ loại (n., v., adj.)",
    "meaning": "nghĩa tiếng Việt chính xác",
    "clinicalNote": "ghi chú lâm sàng ngắn gọn",
    "example": "1 câu ví dụ tiếng Anh",
    "exampleVi": "dịch câu ví dụ sang tiếng Việt"
  }
]`;
          const models = ["gemini-2.5-flash", "gemini-2.0-flash", "gemini-1.5-flash-latest"];
          for (const m of models) {
            try {
              const res = await fetch(`https://generativelanguage.googleapis.com/v1beta/models/${m}:generateContent?key=${apiKey}`, {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ contents: [{ parts: [{ text: prompt }] }] })
              });
              const data = await res.json();
              const raw = data?.candidates?.[0]?.content?.parts?.[0]?.text;
              if (raw) {
                const clean = raw.replace(/```json/gi, "").replace(/```/g, "").trim();
                const parsed = JSON.parse(clean);
                if (Array.isArray(parsed) && parsed.length > 0) {
                  extractedTerms = parsed.filter(item => item && typeof item.word === "string" && item.word.trim());
                  if (extractedTerms.length > 0) break;
                }
              }
            } catch (e) {
              console.warn(`Lỗi trích xuất Gemini (${m}):`, e);
            }
          }
        }

        // Fallback trích xuất nếu không có API key
        if (!extractedTerms || extractedTerms.length === 0) {
          const matched = vocabList.filter(v => rawContent.toLowerCase().includes(v.word.toLowerCase().split("/")[0].trim()));
          extractedTerms = matched.slice(0, 10);
        }

        loadingBox.classList.add("hidden");
        if (extractedTerms.length > 0) {
          docExtractedVocabList = extractedTerms;
          document.getElementById("docExamSetupView").classList.add("hidden");
          document.getElementById("docExamResultView").classList.remove("hidden");

          // Hiện nút nạp từ vựng và ẩn nút làm lại đề khi ở chế độ Trích xuất từ vựng
          document.getElementById("btnDocImportAllExtracted").classList.remove("hidden");
          document.getElementById("btnDocRetryExam").classList.add("hidden");

          document.getElementById("docExamFinalScore").textContent = `🎉 Đã trích xuất thành công ${extractedTerms.length} thuật ngữ!`;

          const reviewBox = document.getElementById("docExtractedVocabReviewBox");
          reviewBox.innerHTML = "<p class='font-bold text-slate-700 dark:text-slate-200 mb-2'>Danh sách thuật ngữ nhận diện:</p>";
          extractedTerms.forEach(t => {
            const row = document.createElement("div");
            row.className = "p-2 border-b border-slate-100 dark:border-slate-700 flex items-center justify-between gap-2";
            row.innerHTML = `
              <div>
                <span class="font-bold text-slate-900 dark:text-white">${t.word}</span>
                <span class="text-[11px] font-mono text-teal-600 dark:text-teal-400">${t.ipa || ""}</span>
                <p class="text-xs text-slate-600 dark:text-slate-300">${t.meaning || ""}</p>
              </div>
              <button type="button" class="btn-speak-extracted text-teal-600 hover:text-teal-700 p-1">
                <i class="fa-solid fa-volume-high"></i>
              </button>
            `;
            row.querySelector(".btn-speak-extracted").onclick = () => speakText(t.word);
            reviewBox.appendChild(row);
          });
          showToast(`Đã trích xuất ${extractedTerms.length} từ vựng!`, "success");
        } else {
          showToast("Không tìm thấy thuật ngữ nào phù hợp.", "error");
        }
      };

      document.getElementById("btnDocImportAllExtracted").onclick = () => {
        if (!docExtractedVocabList || docExtractedVocabList.length === 0) {
          return showToast("Chưa có danh sách từ vựng để nạp!", "info");
        }
        const unitName = "Tài Liệu Mới";
        let added = 0;
        const existingWords = new Set(vocabList.map(v => (v.word || "").toLowerCase().trim()));

        docExtractedVocabList.forEach(item => {
          if (!item || typeof item.word !== "string") return;
          const cleanKey = item.word.toLowerCase().trim();
          if (cleanKey && !existingWords.has(cleanKey)) {
            existingWords.add(cleanKey);
            vocabList.push({
              id: "doc_" + Date.now() + "_" + Math.random().toString(36).slice(2, 6),
              unit: unitName,
              word: item.word.trim(),
              ipa: item.ipa || `/${cleanKey}/`,
              pos: item.pos || "n.",
              meaning: item.meaning || item.word.trim(),
              relatedTerms: ["Document Extraction"],
              example: item.example || `Clinical study of ${item.word.trim()} is highlighted in this dental lecture.`,
              exampleVi: item.exampleVi || `Nghiên cứu lâm sàng về ${item.meaning || item.word.trim()} được nhấn mạnh trong bài học.`,
              clinicalNote: item.clinicalNote || "Trích xuất từ tài liệu bài giảng.",
              srsLevel: 0,
              mistakeCount: 0
            });
            added++;
          }
        });

        selectedUnits.add(unitName);
        saveDatabase();
        syncAllViews();
        showToast(added > 0 ? `Đã thêm thành công ${added} từ mới vào "${unitName}"!` : "Tất cả các từ này đã có sẵn trong kho học tập!", "success");
      };

