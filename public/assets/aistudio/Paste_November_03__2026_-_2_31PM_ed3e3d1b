#### 6. Lỗi Chiều "Điền khuyết câu lâm sàng" (`context`) có nguy cơ lộ đáp án nếu câu ví dụ dùng từ biến thể

* **Vị trí:** Hàm `maskWordInSentence(sentence, rawWord)`.
* **Nguyên nhân:** Với một số cụm từ phức hợp (như `"Evaluate / Assess"`, `"Identify / Detect"`, `"Tooth / teeth"` hoặc từ do người dùng tự nhập), nếu câu `example` chứa dạng chia động từ bất quy tắc hoặc từ viết tắt mà Regex không tìm thấy để thay bằng `[_____]`, câu hỏi Điền khuyết sẽ hiển thị nguyên văn câu ví dụ mà không có chỗ trống nào, hoặc giữ nguyên từ cần hỏi trên đề bài.
* **Mã sửa lỗi (Nâng cấp `maskWordInSentence`):**

```javascript
function maskWordInSentence(sentence, rawWord) {
  if (!sentence || !rawWord) return sentence || "";
  let masked = sentence;
  const variants = new Set();

  rawWord.split("/").forEach(part => {
    const noParen = part.replace(/\([^)]*\)/g, "").trim();
    if (noParen) {
      variants.add(noParen);
      // Nếu là động từ/danh từ tận cùng bằng 'e' hoặc 'y', thêm gốc từ cắt đuôi để bắt được dạng -ing, -ed, -ies
      if (noParen.length > 4 && (noParen.endsWith("e") || noParen.endsWith("y"))) {
        variants.add(noParen.slice(0, -1));
      }
    }
    const match = part.match(/\(([^)]+)\)/);
    if (match && match[1]) variants.add(match[1].trim());
  });

  Array.from(variants)
    .sort((a, b) => b.length - a.length)
    .forEach(v => {
      if (v.length >= 2) {
        const escaped = v.replace(/[.*+?^${}()|[\]\\]/g, "\\$&");
        masked = masked.replace(new RegExp("\\b" + escaped + "\\w*", "gi"), "[_____]");
      }
    });

  // Phòng vệ an toàn: Nếu câu ví dụ dùng từ đồng nghĩa hoàn toàn khác khiến chưa có dấu [_____]
  if (!masked.includes("[_____]")) {
    masked = `${masked} (Thuật ngữ tương ứng: [_____])`;
  }
  return masked;
}

```

