#### 3. Lỗi mất đồng bộ điểm nhớ SRS giữa các từ vựng xuất hiện lặp lại ở nhiều Unit

* **Vị trí:** Hàm `recordStudyOutcome()`, `updateOutcomeMemoryOnly()`, và sự kiện chấm điểm SRS ở Flashcard (`bindSrs`).
* **Nguyên nhân:** Kho dữ liệu có hơn **20 thuật ngữ xuất hiện lặp lại ở nhiều Unit** (ví dụ: `Oral cavity` ở Unit 1, 3, 5; `Gingivitis` và `Periodontitis` ở Unit 4, 5; `Dental caries` và `White spot lesion` ở Unit 5, 7; `Bone loss` ở Unit 5, 6; `Enamel` ở Unit 1, 5...). Hiện tại khi bạn học thuộc một từ ở Unit 1 (`srsLevel = 3`), bản sao của từ đó ở Unit 5 vẫn nằm ở mức `0 (Chưa học)`.
* **Mã sửa lỗi (Bổ sung hàm đồng bộ liên Unit `syncCrossUnitSrs`):**

```javascript
function syncCrossUnitSrs(sourceItem) {
  if (!sourceItem || !sourceItem.word) return;
  const targetVariants = extractAllVariants(sourceItem.word);
  if (targetVariants.length === 0) return;

  vocabList.forEach(v => {
    if (v.id === sourceItem.id) return;
    const vVariants = extractAllVariants(v.word);
    // Nếu trùng thuật ngữ tiếng Anh chính hoặc các biến thể đồng nghĩa
    if (vVariants.some(vw => targetVariants.includes(vw))) {
      v.srsLevel = sourceItem.srsLevel;
      v.mistakeCount = sourceItem.mistakeCount;
    }
  });
}

function recordStudyOutcome(item, isCorrect) {
  if (!item) return;
  updateOutcomeMemoryOnly(item, isCorrect);
  saveDatabase();
}

function updateOutcomeMemoryOnly(item, isCorrect) {
  if (!item) return;
  if (isCorrect) {
    if ((item.mistakeCount || 0) > 0) item.mistakeCount--;
    if ((item.mistakeCount || 0) === 0) {
      item.srsLevel = Math.min(3, Math.max(2, (item.srsLevel || 0) + 1));
    }
  } else {
    item.mistakeCount = (item.mistakeCount || 0) + 1;
    item.srsLevel = 1;
  }
  syncCrossUnitSrs(item);
}

```

*(Lưu ý: Trong hàm `bindSrs(id, lvl)` của Flashcard, gọi thêm `syncCrossUnitSrs(item);` ngay trước `saveDatabase();`).*

