#### 7. Lỗi phím tắt bàn phím bị kích hoạt nhầm khi đang mở Modal & Thiếu phím tắt Tab 4 (Sprint), Tab 6 (CBT)

* **Vị trí:** Sự kiện `window.addEventListener("keydown", ...)` ở cuối file.
* **Nguyên nhân:**
1. Khi đang mở bất kỳ Modal nào (Hướng dẫn, AI Hub, Thông báo), nếu người dùng nhấn `Space` hoặc `Mũi tên`, câu hỏi bên dưới vẫn tự nhảy hoặc phát âm.
2. Chưa hỗ trợ phím tắt `A, B, C, D` (hoặc `1, 2, 3, 4`), phím `F` (gắn cờ) và `Mũi tên Trái/Phải` trong Phòng thi CBT (Tab 6) như mục tiêu Roadmap.


* **Mã sửa lỗi (Thay thế khối `keydown` ở cuối hàm `initDentalEnglishApp`):**

```javascript
window.addEventListener("keydown", e => {
  if (["INPUT", "TEXTAREA", "SELECT"].includes(document.activeElement?.tagName)) return;

  // Chặn phím tắt nếu đang có bất kỳ cửa sổ Modal nào mở
  const anyModalOpen = ["guideModal", "authorModal", "specialtyModal", "aiHubModal", "pwaModal", "jsonModal", "whatsNewModal"]
    .some(id => {
      const el = document.getElementById(id);
      return el && !el.classList.contains("hidden");
    });
  if (anyModalOpen) return;

  if (currentActiveTab === "quiz") {
    if (["1", "2", "3", "4", "5", "6", "7", "8"].includes(e.key) && !currentQuizAnswered) {
      const btns = document.querySelectorAll(".quiz-opt-btn");
      if (btns[parseInt(e.key, 10) - 1]) btns[parseInt(e.key, 10) - 1].click();
    } else if ((e.key === "Enter" || e.key === "ArrowRight") && currentQuizAnswered) {
      document.getElementById("btnNextQuizQuestion").click();
    } else if (e.code === "Space") {
      e.preventDefault(); document.getElementById("btnSpeakQuizPrompt").click();
    }
  } else if (currentActiveTab === "flashcard") {
    if (e.code === "Space") {
      e.preventDefault(); document.getElementById("btnFcSpeakFront").click();
    } else if (e.key === "ArrowRight") {
      document.getElementById("btnFcNext").click();
    } else if (e.key === "ArrowLeft") {
      document.getElementById("btnFcPrev").click();
    } else if (["ArrowUp", "ArrowDown", "Enter"].includes(e.key)) {
      e.preventDefault(); document.getElementById("fcCardInner").click();
    }
  } else if (currentActiveTab === "sprint" && isSprintActive && !isSprintPaused) {
    if (["1", "2", "3", "4"].includes(e.key)) {
      const btns = document.querySelectorAll("#sprintOptionsBox button");
      if (btns[parseInt(e.key, 10) - 1]) btns[parseInt(e.key, 10) - 1].click();
    }
  } else if (currentActiveTab === "cbt" && !document.getElementById("cbtExamView").classList.contains("hidden")) {
    const key = e.key.toUpperCase();
    const optMap = { "A": 0, "B": 1, "C": 2, "D": 3, "1": 0, "2": 1, "3": 2, "4": 3 };
    if (optMap[key] !== undefined) {
      const btns = document.querySelectorAll("#cbtOptionsContainer button");
      if (btns[optMap[key]]) btns[optMap[key]].click();
    } else if (key === "F") {
      e.preventDefault(); document.getElementById("btnFlagCBT").click();
    } else if (e.key === "ArrowRight" || e.key === "Enter") {
      e.preventDefault(); document.getElementById("btnCBTNext").click();
    } else if (e.key === "ArrowLeft") {
      e.preventDefault(); document.getElementById("btnCBTPrev").click();
    }
  }
});

```

